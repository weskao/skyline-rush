#!/bin/sh
# Check module-size limits on every local push before the existing UI layout gate.
# GitHub API/connector pushes do not run local hooks; remote CI remains mandatory.
echo "pre-push: checking source module sizes (tests/module-size.test.js)..." >&2
if ! node --test tests/module-size.test.js >&2; then
  echo "pre-push: BLOCKED - module size check failed." >&2
  echo "  Test: tests/module-size.test.js" >&2
  echo "  Rules: .claude/rules/module-size.md" >&2
  echo "  Review the File / Current lines / Allowed lines / Exceeded by details above." >&2
  echo "  Fix the named source file(s), then run: node --test tests/module-size.test.js" >&2
  exit 1
fi

# Run home-screen layout browser tests on relevant UI changes.
# SKIP_LAYOUT_GATE bypasses only the layout gate, not the module-size check.
[ "${SKIP_LAYOUT_GATE:-}" = 1 ] && exit 0
zero=0000000000000000000000000000000000000000
ui='^(index\.html|src/(App\.vue|main\.js|style\.css|locales/))'
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  base=$remote_sha
  [ "$base" = "$zero" ] && base=$(git merge-base origin/main "$local_sha" 2>/dev/null)
  [ -n "$base" ] || continue
  git diff --name-only "$base" "$local_sha" | grep -Eq "$ui" && changed=1
done
[ -n "${changed:-}" ] || exit 0
echo "pre-push: home-screen files changed; running npm run test:layout (a few minutes)..." >&2
# A preview server another worktree's test run still holds on 5178 would abort the gate; take a free port.
PLAYWRIGHT_PORT=$(node -e "const s=require('net').createServer().listen(0,'127.0.0.1',()=>{console.log(s.address().port);s.close()})")
export PLAYWRIGHT_PORT
if ! npm run test:layout >&2; then
  echo "pre-push: layout tests failed. Fix them before pushing (skip once: SKIP_LAYOUT_GATE=1 git push)." >&2
  exit 1
fi
