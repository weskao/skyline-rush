{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/game-types.js",
    "src/hud-dom.js",
    "tests/type-fixtures/valid.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/type-fixtures/invalid.js"
  ]
}
