rules_version = '2';
service cloud.firestore {
  function trackIds() {
    return ['coast', 'neon', 'canyon', 'aurora', 'spiral',
      'taipei', 'tokyo', 'alpine', 'coastal', 'cosmic'];
  }

  // Classic best ids: every track plus each `<track>@<layout>` it has had (recordTrackIds in src/record-layout.ts).
  function bestIds() {
    return trackIds().concat(['coast@2', 'coast@3', 'neon@2', 'neon@3', 'canyon@2', 'canyon@3', 'spiral@2', 'spiral@3',
      'aurora@2', 'taipei@2', 'tokyo@2', 'alpine@2', 'coastal@2', 'cosmic@2',
      'coast@4', 'neon@4', 'canyon@4', 'spiral@4',
      'coast@5', 'neon@5', 'canyon@5', 'aurora@4', 'spiral@5',
      'coast@6', 'neon@6', 'canyon@6', 'aurora@5', 'spiral@6', 'neon@7', 'canyon@7',
      'aurora@3', 'taipei@3', 'tokyo@3', 'alpine@3', 'coastal@3', 'cosmic@3',
      'aurora@6', 'spiral@7', 'taipei@4', 'tokyo@4', 'tokyo@5', 'alpine@4', 'coastal@4', 'cosmic@4',
      'frostbite-canyon@t1l1', 'dune-tempest@t1l1', 'dune-tempest@t2l1', 'skyfall-archipelago@t1l1',
      'stormline-megacity@t1l1', 'volcanic-crown@t1l1', 'monsoon-ruins@t1l1']); // CourseGraph sprints: `<track>@t<topology>l<layout>`
  }

  function validMedal(values, id) {
    // A missing medal uses a valid default. A present non-string fails matches().
    return values.get(id, '2000-01-01T00:00:00.000Z')
      .matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
  }

  // Keys are already limited to trackIds(); one list check replaces ten per-id lookups (expression budget).
  function validStars(stars) {
    return stars.values().hasOnly([1, 2, 3]);
  }

  // The allowed keys are checked separately. Validate their values as a list, so every check
  // uses a list index instead of a defaulted map lookup and a full save fits under the
  // 1000-expression limit. Missing entries are padded with a legal time (302400 seconds).
  function validBests(b) {
    let eight = [302400, 302400, 302400, 302400, 302400, 302400, 302400, 302400];
    let sixteen = eight.concat(eight);
    let thirtyTwo = sixteen.concat(sixteen);
    let times = b.values().concat(thirtyTwo).concat(thirtyTwo);
    return math.abs(times[0] - 302400) < 302400
      && math.abs(times[1] - 302400) < 302400
      && math.abs(times[2] - 302400) < 302400
      && math.abs(times[3] - 302400) < 302400
      && math.abs(times[4] - 302400) < 302400
      && math.abs(times[5] - 302400) < 302400
      && math.abs(times[6] - 302400) < 302400
      && math.abs(times[7] - 302400) < 302400
      && math.abs(times[8] - 302400) < 302400
      && math.abs(times[9] - 302400) < 302400
      && math.abs(times[10] - 302400) < 302400
      && math.abs(times[11] - 302400) < 302400
      && math.abs(times[12] - 302400) < 302400
      && math.abs(times[13] - 302400) < 302400
      && math.abs(times[14] - 302400) < 302400
      && math.abs(times[15] - 302400) < 302400
      && math.abs(times[16] - 302400) < 302400
      && math.abs(times[17] - 302400) < 302400
      && math.abs(times[18] - 302400) < 302400
      && math.abs(times[19] - 302400) < 302400
      && math.abs(times[20] - 302400) < 302400
      && math.abs(times[21] - 302400) < 302400
      && math.abs(times[22] - 302400) < 302400
      && math.abs(times[23] - 302400) < 302400
      && math.abs(times[24] - 302400) < 302400
      && math.abs(times[25] - 302400) < 302400
      && math.abs(times[26] - 302400) < 302400
      && math.abs(times[27] - 302400) < 302400
      && math.abs(times[28] - 302400) < 302400
      && math.abs(times[29] - 302400) < 302400
      && math.abs(times[30] - 302400) < 302400
      && math.abs(times[31] - 302400) < 302400
      && math.abs(times[32] - 302400) < 302400
      && math.abs(times[33] - 302400) < 302400
      && math.abs(times[34] - 302400) < 302400
      && math.abs(times[35] - 302400) < 302400
      && math.abs(times[36] - 302400) < 302400
      && math.abs(times[37] - 302400) < 302400
      && math.abs(times[38] - 302400) < 302400
      && math.abs(times[39] - 302400) < 302400
      && math.abs(times[40] - 302400) < 302400
      && math.abs(times[41] - 302400) < 302400
      && math.abs(times[42] - 302400) < 302400
      && math.abs(times[43] - 302400) < 302400
      && math.abs(times[44] - 302400) < 302400
      && math.abs(times[45] - 302400) < 302400
      && math.abs(times[46] - 302400) < 302400
      && math.abs(times[47] - 302400) < 302400
      && math.abs(times[48] - 302400) < 302400
      && math.abs(times[49] - 302400) < 302400
      && math.abs(times[50] - 302400) < 302400
      && math.abs(times[51] - 302400) < 302400
      && math.abs(times[52] - 302400) < 302400
      && math.abs(times[53] - 302400) < 302400
      && math.abs(times[54] - 302400) < 302400
      && math.abs(times[55] - 302400) < 302400
      && math.abs(times[56] - 302400) < 302400
      && math.abs(times[57] - 302400) < 302400
      && math.abs(times[58] - 302400) < 302400
      && math.abs(times[59] - 302400) < 302400
      && math.abs(times[60] - 302400) < 302400;
  }

  function validMedals(medals) {
    return validMedal(medals, 'first-win') && validMedal(medals, 'clean-run')
      && validMedal(medals, 'perfect-five') && validMedal(medals, 'nitro-chain');
  }

  function validScoreMaps(data) {
    return data.stars is map && data.bests is map && data.medals is map
      && data.stars.keys().hasOnly(trackIds())
      && data.bests.keys().hasOnly(bestIds())
      && data.medals.keys().hasOnly(['first-win', 'clean-run', 'perfect-five', 'nitro-chain'])
      && validStars(data.stars) && validBests(data.bests) && validMedals(data.medals);
  }

  match /databases/{database}/documents {
    // No list access: the identity cache is private per authenticated UID.
    match /accounts/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email'])
        && request.resource.data.keys().hasAny(['displayName', 'email'])
        && (!request.resource.data.keys().hasAny(['displayName'])
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 200))
        && (!request.resource.data.keys().hasAny(['email'])
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 320
            && request.resource.data.email.matches('^.+@.+[.].+$')));
    }

    match /modeBests/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'bests', 'stunts'])
        && request.resource.data.keys().hasAll(['version', 'bests', 'stunts'])
        && request.resource.data.version == 1
        && request.resource.data.bests is map
        && request.resource.data.stunts is map
        && request.resource.data.bests.size() <= 200
        && request.resource.data.stunts.size() <= 200;
    }

    // Disposable trial progress. This collection grants no production entitlement.
    match /wave3PreviewEconomy/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'checkpoint'])
        && request.resource.data.keys().hasAll(['version', 'checkpoint'])
        && request.resource.data.version == 1
        && request.resource.data.checkpoint is string
        && request.resource.data.checkpoint.size() > 0
        && request.resource.data.checkpoint.size() <= 65536;
    }

    match /saves/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily', 'car', 'gtTrialStartedAt'])
        && request.resource.data.keys().hasAll(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily'])
        && request.resource.data.version == 2
        // Optional equipped car (CARS in src/car-catalog.ts); a save without it is the Roadster.
        && request.resource.data.get('car', 'roadster') in ['roadster', 'crimson-gt']
        && request.resource.data.get('gtTrialStartedAt', 1) is int
        && request.resource.data.get('gtTrialStartedAt', 1) > 0
        && request.resource.data.get('gtTrialStartedAt', 1) <= 9007199254740991
        && request.resource.data.unlocked is list
        && request.resource.data.unlocked.size() <= 10
        && request.resource.data.unlocked.hasAll(['coast'])
        && request.resource.data.unlocked.hasOnly(trackIds())
        && validScoreMaps(request.resource.data)
        && request.resource.data.history is list && request.resource.data.history.size() <= 50
        && request.resource.data.modeHistory is list && request.resource.data.modeHistory.size() <= 50
        && request.resource.data.daily is list && request.resource.data.daily.size() <= 50;
    }
  }
}
