rules_version = '2';
service cloud.firestore {
  function trackIds() {
    return ['coast', 'neon', 'canyon', 'aurora', 'spiral',
      'taipei', 'tokyo', 'alpine', 'coastal', 'cosmic'];
  }

  // Classic best ids: every track plus each `<track>@<layout>` it has had (recordTrackIds in src/record-layout.ts).
  function bestIds() {
    return trackIds().concat(['coast@2', 'coast@3', 'neon@2', 'neon@3', 'canyon@2', 'canyon@3', 'spiral@2', 'spiral@3',
      'aurora@2', 'taipei@2', 'tokyo@2', 'alpine@2', 'coastal@2', 'cosmic@2',
      'coast@4', 'neon@4', 'canyon@4', 'spiral@4',
      'coast@5', 'neon@5', 'canyon@5', 'aurora@4', 'spiral@5',
      'coast@6', 'neon@6', 'canyon@6', 'aurora@5', 'spiral@6',
      'aurora@3', 'taipei@3', 'tokyo@3', 'alpine@3', 'coastal@3', 'cosmic@3',
      'frostbite-canyon@t1l1', 'dune-tempest@t1l1', 'dune-tempest@t2l1', 'skyfall-archipelago@t1l1',
      'stormline-megacity@t1l1', 'volcanic-crown@t1l1', 'monsoon-ruins@t1l1']); // CourseGraph sprints: `<track>@t<topology>l<layout>`
  }

  function validMedal(values, id) {
    // A missing medal uses a valid default. A present non-string fails matches().
    return values.get(id, '2000-01-01T00:00:00.000Z')
      .matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
  }

  // Keys are already limited to trackIds(); one list check replaces ten per-id lookups (expression budget).
  function validStars(stars) {
    return stars.values().hasOnly([1, 2, 3]);
  }

  // Rules stop at 1000 evaluated expressions per write. Each best is one defaulted lookup, 0 < best < 604800 s
  // (a missing id takes the valid default), written inline: a per-id helper call cost one extra expression per
  // id, and at 50 ids that rejected every cloud save (2026-11-13). Measured on the emulator: 60 ids fit, 70 do
  // not. tests/record-layout.test.js caps the list at 60; more ids need a new budget measurement first.
  function validBests(b) {
    return math.abs(b.get('coast', 302400) - 302400) < 302400
      && math.abs(b.get('neon', 302400) - 302400) < 302400
      && math.abs(b.get('canyon', 302400) - 302400) < 302400
      && math.abs(b.get('aurora', 302400) - 302400) < 302400
      && math.abs(b.get('spiral', 302400) - 302400) < 302400
      && math.abs(b.get('taipei', 302400) - 302400) < 302400
      && math.abs(b.get('tokyo', 302400) - 302400) < 302400
      && math.abs(b.get('alpine', 302400) - 302400) < 302400
      && math.abs(b.get('coastal', 302400) - 302400) < 302400
      && math.abs(b.get('cosmic', 302400) - 302400) < 302400
      && math.abs(b.get('coast@2', 302400) - 302400) < 302400
      && math.abs(b.get('coast@3', 302400) - 302400) < 302400
      && math.abs(b.get('neon@2', 302400) - 302400) < 302400
      && math.abs(b.get('neon@3', 302400) - 302400) < 302400
      && math.abs(b.get('canyon@2', 302400) - 302400) < 302400
      && math.abs(b.get('canyon@3', 302400) - 302400) < 302400
      && math.abs(b.get('spiral@2', 302400) - 302400) < 302400
      && math.abs(b.get('spiral@3', 302400) - 302400) < 302400
      && math.abs(b.get('aurora@2', 302400) - 302400) < 302400
      && math.abs(b.get('taipei@2', 302400) - 302400) < 302400
      && math.abs(b.get('tokyo@2', 302400) - 302400) < 302400
      && math.abs(b.get('alpine@2', 302400) - 302400) < 302400
      && math.abs(b.get('coastal@2', 302400) - 302400) < 302400
      && math.abs(b.get('cosmic@2', 302400) - 302400) < 302400
      && math.abs(b.get('coast@4', 302400) - 302400) < 302400
      && math.abs(b.get('neon@4', 302400) - 302400) < 302400
      && math.abs(b.get('canyon@4', 302400) - 302400) < 302400
      && math.abs(b.get('spiral@4', 302400) - 302400) < 302400
      && math.abs(b.get('coast@5', 302400) - 302400) < 302400
      && math.abs(b.get('neon@5', 302400) - 302400) < 302400
      && math.abs(b.get('canyon@5', 302400) - 302400) < 302400
      && math.abs(b.get('aurora@4', 302400) - 302400) < 302400
      && math.abs(b.get('spiral@5', 302400) - 302400) < 302400
      && math.abs(b.get('coast@6', 302400) - 302400) < 302400
      && math.abs(b.get('neon@6', 302400) - 302400) < 302400
      && math.abs(b.get('canyon@6', 302400) - 302400) < 302400
      && math.abs(b.get('aurora@5', 302400) - 302400) < 302400
      && math.abs(b.get('spiral@6', 302400) - 302400) < 302400
      && math.abs(b.get('aurora@3', 302400) - 302400) < 302400
      && math.abs(b.get('taipei@3', 302400) - 302400) < 302400
      && math.abs(b.get('tokyo@3', 302400) - 302400) < 302400
      && math.abs(b.get('alpine@3', 302400) - 302400) < 302400
      && math.abs(b.get('coastal@3', 302400) - 302400) < 302400
      && math.abs(b.get('cosmic@3', 302400) - 302400) < 302400
      && math.abs(b.get('frostbite-canyon@t1l1', 302400) - 302400) < 302400
      && math.abs(b.get('dune-tempest@t1l1', 302400) - 302400) < 302400
      && math.abs(b.get('dune-tempest@t2l1', 302400) - 302400) < 302400
      && math.abs(b.get('skyfall-archipelago@t1l1', 302400) - 302400) < 302400
      && math.abs(b.get('stormline-megacity@t1l1', 302400) - 302400) < 302400
      && math.abs(b.get('volcanic-crown@t1l1', 302400) - 302400) < 302400
      && math.abs(b.get('monsoon-ruins@t1l1', 302400) - 302400) < 302400;
  }

  function validMedals(medals) {
    return validMedal(medals, 'first-win') && validMedal(medals, 'clean-run')
      && validMedal(medals, 'perfect-five') && validMedal(medals, 'nitro-chain');
  }

  function validScoreMaps(data) {
    return data.stars is map && data.bests is map && data.medals is map
      && data.stars.keys().hasOnly(trackIds())
      && data.bests.keys().hasOnly(bestIds())
      && data.medals.keys().hasOnly(['first-win', 'clean-run', 'perfect-five', 'nitro-chain'])
      && validStars(data.stars) && validBests(data.bests) && validMedals(data.medals);
  }

  match /databases/{database}/documents {
    // No list access: the identity cache is private per authenticated UID.
    match /accounts/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email'])
        && request.resource.data.keys().hasAny(['displayName', 'email'])
        && (!request.resource.data.keys().hasAny(['displayName'])
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 200))
        && (!request.resource.data.keys().hasAny(['email'])
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 320
            && request.resource.data.email.matches('^.+@.+[.].+$')));
    }

    match /modeBests/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'bests', 'stunts'])
        && request.resource.data.keys().hasAll(['version', 'bests', 'stunts'])
        && request.resource.data.version == 1
        && request.resource.data.bests is map
        && request.resource.data.stunts is map
        && request.resource.data.bests.size() <= 200
        && request.resource.data.stunts.size() <= 200;
    }

    match /saves/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily', 'car'])
        && request.resource.data.keys().hasAll(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily'])
        && request.resource.data.version == 2
        // Optional equipped car (CARS in src/car-catalog.ts); a save without it is the Roadster.
        && request.resource.data.get('car', 'roadster') in ['roadster', 'crimson-gt']
        && request.resource.data.unlocked is list
        && request.resource.data.unlocked.size() <= 10
        && request.resource.data.unlocked.hasAll(['coast'])
        && request.resource.data.unlocked.hasOnly(trackIds())
        && validScoreMaps(request.resource.data)
        && request.resource.data.history is list && request.resource.data.history.size() <= 50
        && request.resource.data.modeHistory is list && request.resource.data.modeHistory.size() <= 50
        && request.resource.data.daily is list && request.resource.data.daily.size() <= 50;
    }
  }
}
