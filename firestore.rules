rules_version = '2';
service cloud.firestore {
  function trackIds() {
    return ['coast', 'neon', 'canyon', 'aurora', 'spiral',
      'taipei', 'tokyo', 'alpine', 'coastal', 'cosmic'];
  }

  // Classic best ids: every track plus each `<track>@<layout>` it has had (recordTrackIds in src/record-layout.ts).
  function bestIds() {
    return trackIds().concat(['coast@2', 'coast@3', 'neon@2', 'neon@3', 'canyon@2', 'canyon@3', 'spiral@2', 'spiral@3',
      'aurora@2', 'taipei@2', 'tokyo@2', 'alpine@2', 'coastal@2', 'cosmic@2',
      'coast@4', 'neon@4', 'canyon@4', 'spiral@4',
      'aurora@3', 'taipei@3', 'tokyo@3', 'alpine@3', 'coastal@3', 'cosmic@3',
      'frostbite-canyon@t1l1', 'stormline-megacity@t1l1', 'volcanic-crown@t1l1']); // CourseGraph sprints: `<track>@t<topology>l<layout>`
  }

  // Rules stop at 1000 evaluated expressions per write, and each map lookup counts: the old keys().hasAny([id])
  // form rejected a player holding every star and best (already 10 stars + 14 bests before stage 2).
  // A defaulted lookup avoids evaluating a separate presence check for every optional field, and the checks are
  // written out rather than called per id: a validBest(values, id) helper's call overhead pushed the fullest save
  // (37 bests) over the limit. Groups stay at 8 checks, since one longer chain fails to compile ("too complex").
  // Star: 1-3. Best: 0 < s < 604800 (one week) in a single lookup.
  function validMedal(values, id) {
    return !(id in values) ||
      (values[id] is string &&
        values[id].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'));
  }

  function validStars0(stars) {
    return stars.get('coast', 1) in [1, 2, 3]
      && stars.get('neon', 1) in [1, 2, 3]
      && stars.get('canyon', 1) in [1, 2, 3]
      && stars.get('aurora', 1) in [1, 2, 3]
      && stars.get('spiral', 1) in [1, 2, 3]
      && stars.get('taipei', 1) in [1, 2, 3]
      && stars.get('tokyo', 1) in [1, 2, 3]
      && stars.get('alpine', 1) in [1, 2, 3];
  }
  function validStars1(stars) {
    return stars.get('coastal', 1) in [1, 2, 3]
      && stars.get('cosmic', 1) in [1, 2, 3];
  }
  function validStars(stars) {
    return validStars0(stars) && validStars1(stars);
  }

  function validBests0(bests) {
    return math.abs(bests.get('coast', 302400) - 302400) < 302400
      && math.abs(bests.get('neon', 302400) - 302400) < 302400
      && math.abs(bests.get('canyon', 302400) - 302400) < 302400
      && math.abs(bests.get('aurora', 302400) - 302400) < 302400
      && math.abs(bests.get('spiral', 302400) - 302400) < 302400
      && math.abs(bests.get('taipei', 302400) - 302400) < 302400
      && math.abs(bests.get('tokyo', 302400) - 302400) < 302400
      && math.abs(bests.get('alpine', 302400) - 302400) < 302400;
  }
  function validBests1(bests) {
    return math.abs(bests.get('coastal', 302400) - 302400) < 302400
      && math.abs(bests.get('cosmic', 302400) - 302400) < 302400
      && math.abs(bests.get('coast@2', 302400) - 302400) < 302400
      && math.abs(bests.get('neon@2', 302400) - 302400) < 302400
      && math.abs(bests.get('canyon@2', 302400) - 302400) < 302400
      && math.abs(bests.get('spiral@2', 302400) - 302400) < 302400
      && math.abs(bests.get('coast@3', 302400) - 302400) < 302400
      && math.abs(bests.get('neon@3', 302400) - 302400) < 302400;
  }
  function validBests2(bests) {
    return math.abs(bests.get('canyon@3', 302400) - 302400) < 302400
      && math.abs(bests.get('spiral@3', 302400) - 302400) < 302400
      && math.abs(bests.get('aurora@2', 302400) - 302400) < 302400
      && math.abs(bests.get('taipei@2', 302400) - 302400) < 302400
      && math.abs(bests.get('tokyo@2', 302400) - 302400) < 302400
      && math.abs(bests.get('alpine@2', 302400) - 302400) < 302400
      && math.abs(bests.get('coastal@2', 302400) - 302400) < 302400
      && math.abs(bests.get('cosmic@2', 302400) - 302400) < 302400;
  }
  function validBests3(bests) {
    return math.abs(bests.get('coast@4', 302400) - 302400) < 302400
      && math.abs(bests.get('neon@4', 302400) - 302400) < 302400
      && math.abs(bests.get('canyon@4', 302400) - 302400) < 302400
      && math.abs(bests.get('spiral@4', 302400) - 302400) < 302400
      && math.abs(bests.get('aurora@3', 302400) - 302400) < 302400
      && math.abs(bests.get('taipei@3', 302400) - 302400) < 302400
      && math.abs(bests.get('tokyo@3', 302400) - 302400) < 302400
      && math.abs(bests.get('alpine@3', 302400) - 302400) < 302400;
  }
  function validBests4(bests) {
    return math.abs(bests.get('coastal@3', 302400) - 302400) < 302400
      && math.abs(bests.get('cosmic@3', 302400) - 302400) < 302400
      && math.abs(bests.get('frostbite-canyon@t1l1', 302400) - 302400) < 302400
      && math.abs(bests.get('stormline-megacity@t1l1', 302400) - 302400) < 302400
      && math.abs(bests.get('volcanic-crown@t1l1', 302400) - 302400) < 302400;
  }
  function validBests(bests) {
    return validBests0(bests) && validBests1(bests) && validBests2(bests) && validBests3(bests) && validBests4(bests);
  }

  function validMedals(medals) {
    return validMedal(medals, 'first-win') && validMedal(medals, 'clean-run')
      && validMedal(medals, 'perfect-five') && validMedal(medals, 'nitro-chain');
  }

  function validScoreMaps(data) {
    return data.stars is map && data.bests is map && data.medals is map
      && data.stars.keys().hasOnly(trackIds())
      && data.bests.keys().hasOnly(bestIds())
      && data.medals.keys().hasOnly(['first-win', 'clean-run', 'perfect-five', 'nitro-chain'])
      && validStars(data.stars) && validBests(data.bests) && validMedals(data.medals);
  }

  match /databases/{database}/documents {
    // No list access: the identity cache is private per authenticated UID.
    match /accounts/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email'])
        && request.resource.data.keys().hasAny(['displayName', 'email'])
        && (!request.resource.data.keys().hasAny(['displayName'])
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 200))
        && (!request.resource.data.keys().hasAny(['email'])
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 320
            && request.resource.data.email.matches('^.+@.+[.].+$')));
    }

    match /modeBests/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'bests', 'stunts'])
        && request.resource.data.keys().hasAll(['version', 'bests', 'stunts'])
        && request.resource.data.version == 1
        && request.resource.data.bests is map
        && request.resource.data.stunts is map
        && request.resource.data.bests.size() <= 200
        && request.resource.data.stunts.size() <= 200;
    }

    match /saves/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily'])
        && request.resource.data.keys().hasAll(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily'])
        && request.resource.data.version == 2
        && request.resource.data.unlocked is list
        && request.resource.data.unlocked.size() <= 10
        && request.resource.data.unlocked.hasAll(['coast'])
        && request.resource.data.unlocked.hasOnly(trackIds())
        && validScoreMaps(request.resource.data)
        && request.resource.data.history is list && request.resource.data.history.size() <= 50
        && request.resource.data.modeHistory is list && request.resource.data.modeHistory.size() <= 50
        && request.resource.data.daily is list && request.resource.data.daily.size() <= 50;
    }
  }
}
