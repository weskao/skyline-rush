rules_version = '2';
service cloud.firestore {
  function trackIds() {
    return ['coast', 'neon', 'canyon', 'aurora', 'spiral',
      'taipei', 'tokyo', 'alpine', 'coastal', 'cosmic'];
  }

  // Classic best ids: every track plus each `<track>@<layout>` it has had (recordTrackIds in src/record-layout.ts).
  function bestIds() {
    return trackIds().concat(['coast@2', 'coast@3', 'neon@2', 'neon@3', 'canyon@2', 'canyon@3', 'spiral@2', 'spiral@3',
      'aurora@2', 'taipei@2', 'tokyo@2', 'alpine@2', 'coastal@2', 'cosmic@2',
      'coast@4', 'neon@4', 'canyon@4', 'spiral@4',
      'coast@5', 'neon@5', 'canyon@5', 'aurora@4', 'spiral@5',
      'coast@6', 'neon@6', 'canyon@6', 'aurora@5', 'spiral@6',
      'aurora@3', 'taipei@3', 'tokyo@3', 'alpine@3', 'coastal@3', 'cosmic@3',
      'frostbite-canyon@t1l1', 'dune-tempest@t1l1', 'skyfall-archipelago@t1l1',
      'stormline-megacity@t1l1', 'volcanic-crown@t1l1', 'monsoon-ruins@t1l1']); // CourseGraph sprints: `<track>@t<topology>l<layout>`
  }

  // Rules stop at 1000 evaluated expressions per write, and each map lookup counts: the old keys().hasAny([id])
  // form rejected a player holding every star and best (already 10 stars + 14 bests before stage 2). One
  // A defaulted lookup avoids evaluating a separate presence check for every optional field.
  // Invalid present values still fail the same bounds. This keeps full saves under the 1000-expression limit.
  // 0 < best < 604800 s (one week) in a single lookup.
  function validBest(values, id) {
    return math.abs(values.get(id, 302400) - 302400) < 302400;
  }

  function validMedal(values, id) {
    // A missing medal uses a valid default. A present non-string fails matches().
    return values.get(id, '2000-01-01T00:00:00.000Z')
      .matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
  }

  // Keys are already limited to trackIds(); one list check replaces ten per-id lookups (expression budget).
  function validStars(stars) {
    return stars.values().hasOnly([1, 2, 3]);
  }

  function validBests(bests) {
    return validBest(bests, 'coast') && validBest(bests, 'neon') && validBest(bests, 'canyon')
      && validBest(bests, 'aurora') && validBest(bests, 'spiral') && validBest(bests, 'taipei')
      && validBest(bests, 'tokyo') && validBest(bests, 'alpine') && validBest(bests, 'coastal')
      && validBest(bests, 'cosmic')
      && validBest(bests, 'coast@2') && validBest(bests, 'neon@2')
      && validBest(bests, 'canyon@2') && validBest(bests, 'spiral@2')
      && validBest(bests, 'coast@3') && validBest(bests, 'neon@3')
      && validBest(bests, 'canyon@3') && validBest(bests, 'spiral@3')
      && validBest(bests, 'aurora@2') && validBest(bests, 'taipei@2')
      && validBest(bests, 'tokyo@2') && validBest(bests, 'alpine@2')
      && validBest(bests, 'coastal@2') && validBest(bests, 'cosmic@2')
      && validBest(bests, 'coast@4') && validBest(bests, 'neon@4')
      && validBest(bests, 'canyon@4') && validBest(bests, 'spiral@4')
      && validBest(bests, 'coast@5') && validBest(bests, 'neon@5')
      && validBest(bests, 'canyon@5') && validBest(bests, 'aurora@4') && validBest(bests, 'spiral@5')
      && validBest(bests, 'coast@6') && validBest(bests, 'neon@6')
      && validBest(bests, 'canyon@6') && validBest(bests, 'aurora@5') && validBest(bests, 'spiral@6')
      && validBest(bests, 'aurora@3') && validBest(bests, 'taipei@3')
      && validBest(bests, 'tokyo@3') && validBest(bests, 'alpine@3')
      && validBest(bests, 'coastal@3') && validBest(bests, 'cosmic@3')
      && validBest(bests, 'frostbite-canyon@t1l1') && validBest(bests, 'dune-tempest@t1l1')
      && validBest(bests, 'skyfall-archipelago@t1l1') && validBest(bests, 'stormline-megacity@t1l1')
      && validBest(bests, 'volcanic-crown@t1l1') && validBest(bests, 'monsoon-ruins@t1l1');
  }

  function validMedals(medals) {
    return validMedal(medals, 'first-win') && validMedal(medals, 'clean-run')
      && validMedal(medals, 'perfect-five') && validMedal(medals, 'nitro-chain');
  }

  function validScoreMaps(data) {
    return data.stars is map && data.bests is map && data.medals is map
      && data.stars.keys().hasOnly(trackIds())
      && data.bests.keys().hasOnly(bestIds())
      && data.medals.keys().hasOnly(['first-win', 'clean-run', 'perfect-five', 'nitro-chain'])
      && validStars(data.stars) && validBests(data.bests) && validMedals(data.medals);
  }

  match /databases/{database}/documents {
    // No list access: the identity cache is private per authenticated UID.
    match /accounts/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email'])
        && request.resource.data.keys().hasAny(['displayName', 'email'])
        && (!request.resource.data.keys().hasAny(['displayName'])
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 200))
        && (!request.resource.data.keys().hasAny(['email'])
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 320
            && request.resource.data.email.matches('^.+@.+[.].+$')));
    }

    match /modeBests/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'bests', 'stunts'])
        && request.resource.data.keys().hasAll(['version', 'bests', 'stunts'])
        && request.resource.data.version == 1
        && request.resource.data.bests is map
        && request.resource.data.stunts is map
        && request.resource.data.bests.size() <= 200
        && request.resource.data.stunts.size() <= 200;
    }

    match /saves/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily', 'car'])
        && request.resource.data.keys().hasAll(['version', 'unlocked', 'stars', 'bests', 'medals', 'history', 'modeHistory', 'daily'])
        && request.resource.data.version == 2
        // Optional equipped car (CARS in src/car-catalog.ts); a save without it is the Roadster.
        && request.resource.data.get('car', 'roadster') in ['roadster', 'crimson-gt']
        && request.resource.data.unlocked is list
        && request.resource.data.unlocked.size() <= 10
        && request.resource.data.unlocked.hasAll(['coast'])
        && request.resource.data.unlocked.hasOnly(trackIds())
        && validScoreMaps(request.resource.data)
        && request.resource.data.history is list && request.resource.data.history.size() <= 50
        && request.resource.data.modeHistory is list && request.resource.data.modeHistory.size() <= 50
        && request.resource.data.daily is list && request.resource.data.daily.size() <= 50;
    }
  }
}
