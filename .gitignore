# Keep local logs and event streams out of the public repository.
*.log
*.jsonl

# Local per-device 3D Phase 0 audits. Public repo: NEVER commit machine-specific evidence.
docs/designs/3d-pipeline/audits/

__pycache__/

# Blender saves numbered .blend backups; keep only verified editable masters in Git.
assets-src/**/*.blend[0-9]*
