{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "#garage-skin-ui": ["src/GarageSkinCatalog.vue"],
      "#garage-skin-runtime": ["src/garage-skin-runtime.ts"],
      "#garage-skin-palette": ["src/garage-skin-palette.ts"],
      "#garage-release-config": ["src/garage-release-trial.ts"]
    },
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/type-fixtures"
  ]
}
