{
  "name": "skyline-rush",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/assert-production-locked.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:cloud": "npx -y firebase-tools@15.34.1 emulators:exec --project skyline-rush-weskao --only auth,firestore 'playwright test -c playwright.cloud.config.js && node --test tests/firestore-rules.test.js'",
    "pretest:browser": "node scripts/build-garage-browser.mjs",
    "test:browser": "playwright test",
    "test:layout": "npm run build && playwright test tests/race-modes-browser.spec.js tests/home-shortcuts-browser.spec.js && playwright test tests/i18n-browser.spec.js tests/responsive-browser.spec.js -g \"intro bottom edge|start layout\"",
    "typecheck": "npm run typecheck:ts && npm run typecheck:vue && npm run typecheck:js",
    "typecheck:ts": "tsc --noEmit --project tsconfig.json",
    "typecheck:js": "tsc --noEmit --project jsconfig.json",
    "typecheck:vue": "vue-tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "three": "0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "5.9.3",
    "vite": "^7.1.0",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "imports": {
    "#garage-skin-ui": "./src/GarageSkinCatalog.vue",
    "#garage-skin-runtime": "./src/garage-skin-runtime.ts",
    "#garage-skin-palette": "./src/garage-skin-palette.ts",
    "#garage-void-beams": "./src/garage-void-beams.js",
    "#garage-launch-flare": "./src/garage-launch-flare.js",
    "#garage-nitro-trail": "./src/garage-nitro-trail.js",
    "#garage-release-config": "./src/garage-release-trial.ts"
  }
}
