{
  "name": "skyline-rush",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/assert-production-locked.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "diag:tail": "tail -n 40 -f \"$(ls -t diag-logs/*.jsonl | head -1)\"",
    "test": "node --test tests/*.test.js",
    "test:cloud": "pnpm dlx firebase-tools@15.34.1 emulators:exec --project skyline-rush-weskao --only auth,firestore 'node --test tests/firestore-rules.test.js && playwright test -c playwright.cloud.config.js'",
    "test:browser": "node scripts/build-garage-browser.mjs && playwright test",
    "test:layout": "pnpm run build && playwright test tests/race-modes-browser.spec.js tests/home-shortcuts-browser.spec.js --workers=2 && playwright test tests/i18n-browser.spec.js tests/responsive-browser.spec.js --workers=2 -g \"intro bottom edge|start layout\"",
    "typecheck": "pnpm run typecheck:ts && pnpm run typecheck:vue && pnpm run typecheck:js",
    "typecheck:ts": "tsc --noEmit --project tsconfig.json",
    "typecheck:js": "tsc --noEmit --project jsconfig.json",
    "typecheck:vue": "vue-tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "crucible": "npm:@codepawlhq/crucible@0.21.0",
    "firebase": "^13.1.0",
    "three": "0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "5.9.3",
    "vite": "^7.1.0",
    "vue-tsc": "3.3.13"
  },
  "imports": {
    "#garage-playtest-storage": "./src/access/garage-production.ts",
    "#garage-playtest-equip": "./src/access/garage-production.ts",
    "#garage-skin-ui": "./src/GarageSkinCatalog.vue",
    "#garage-skin-runtime": "./src/garage-skin-runtime.ts",
    "#garage-skin-palette": "./src/garage-skin-palette.ts",
    "#garage-void-beams": "./src/garage-void-beams.js",
    "#garage-launch-flare": "./src/garage-launch-flare.js",
    "#garage-drift-trail": "./src/garage-drift-trail.js",
    "#garage-nitro-trail": "./src/garage-nitro-trail.js",
    "#garage-release-config": "./src/garage-release-trial.ts",
    "#wave3-demo-race": "./src/wave3-race-events.ts",
    "#wave3-demo-mission-ui": "./src/GarageMissionBoard.vue"
  },
  "packageManager": "pnpm@11.28.13"
}
